<Project Sdk="Microsoft.NET.Sdk">
  <Sdk Name="Aspire.AppHost.Sdk" />
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsAspireHost>true</IsAspireHost>
    <!-- Direct dotnet/IDE startup uses the SDK's restored DCP/dashboard packages;
         this scaffold does not require a separately installed Aspire CLI bundle. -->
    <AspireUseCliBundle>false</AspireUseCliBundle>
    <NoWarn>$(NoWarn);ASPIRE010</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.AppHost" />
    <ProjectReference Include="../../src/AI/BankSphere.AI.Api/BankSphere.AI.Api.csproj" />
    <ProjectReference Include="../../src/Services/Customers/BankSphere.Customers.Api/BankSphere.Customers.Api.csproj" />
    <ProjectReference Include="../../src/Services/Accounts/BankSphere.Accounts.Api/BankSphere.Accounts.Api.csproj" />
    <ProjectReference Include="../../src/Services/Transactions/BankSphere.Transactions.Api/BankSphere.Transactions.Api.csproj" />
    <ProjectReference Include="../../src/Services/FraudInvestigation/BankSphere.FraudInvestigation.Api/BankSphere.FraudInvestigation.Api.csproj" />
    <ProjectReference Include="../../src/Services/Compliance/BankSphere.Compliance.Api/BankSphere.Compliance.Api.csproj" />
    <ProjectReference Include="../../src/Services/CreditAssessment/BankSphere.CreditAssessment.Api/BankSphere.CreditAssessment.Api.csproj" />
    <ProjectReference Include="../../src/Integrations/BankSphere.McpServer/BankSphere.McpServer.csproj" />
    <ProjectReference Include="../../src/Integrations/BankSphere.A2AHost/BankSphere.A2AHost.csproj" />
    <ProjectReference Include="../../src/Gateway/BankSphere.Gateway/BankSphere.Gateway.csproj" />
  </ItemGroup>
</Project>
